{
  "name": "inboxscout",
  "version": "1.5.7",
  "description": "AI email intelligence assistant - sorts personal from work mail and delivers daily briefs",
  "main": "out/main/index.js",
  "author": "Cooper Studios LLC <hello@inboxscout.ai>",
  "license": "SEE LICENSE IN LICENSE.md",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/thatcooperguy/inboxscout.git"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "lint": "eslint .",
    "media": "node scripts/render-media.mjs",
    "docs:profiles": "esbuild scripts/gen-profiles-doc.ts --bundle --platform=node --outfile=out/gen-profiles-doc.cjs --log-level=warning && node out/gen-profiles-doc.cjs",
    "package": "electron-vite build && electron-builder --publish never",
    "release": "echo 'Releases are cut by the Release workflow (docs/RELEASING.md); use npm run package locally.' && exit 1"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.0",
    "@ai-sdk/google": "^2.0.0",
    "@ai-sdk/groq": "^2.0.0",
    "@ai-sdk/openai": "^2.0.0",
    "@ai-sdk/openai-compatible": "^1.0.0",
    "@ai-sdk/xai": "^2.0.0",
    "@azure/msal-node": "^3.8.10",
    "@tesseract.js-data/eng": "^1.0.0",
    "@types/qrcode": "^1.5.6",
    "ai": "^5.0.0",
    "better-sqlite3": "^12.0.0",
    "electron-updater": "^6.6.0",
    "exceljs": "^4.4.0",
    "imapflow": "^1.0.160",
    "mailparser": "^3.7.0",
    "mammoth": "^1.12.2",
    "marked": "^15.0.0",
    "node-cron": "^4.0.0",
    "nodemailer": "^10.0.1",
    "pdf-parse": "^2.4.5",
    "qrcode": "^1.5.4",
    "tesseract.js": "^7.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/mailparser": "^3.4.5",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.17.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "@ai-sdk/provider-utils": {
      "undici": "^8.10.2"
    },
    "uuid": "^11.1.1"
  }
}
